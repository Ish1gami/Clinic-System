public class Patient {
    private final String id;
    private final String name;
    private final String dob;
    private final String contact;
    private final String doctor;

    public Patient(String id, String name, String dob, String contact, String doctor) {
        this.id = id;
        this.name = name;
        this.dob = dob;
        this.contact = contact;
        this.doctor = doctor;
    }

    public String getId() { return id; }
    public String getName() { return name; }
    public String getDob() { return dob; }
    public String getContact() { return contact; }
    public String getDoctor() { return doctor; }

    public Object[] toRowData() {
        return new Object[]{id, name, dob, contact, doctor};
    }

    public String toFileFormat() {
        return id + "|" + name + "|" + dob + "|" + contact + "|" + doctor;
    }

    public static Patient fromFileFormat(String line) {
        String[] parts = line.split("\\|", -1);
        if (parts.length == 5) {
            return new Patient(parts[0], parts[1], parts[2], parts[3], parts[4]);
        }
        return null;
    }
}
