import javax.swing.*;
import javax.swing.event.DocumentEvent;
import javax.swing.event.DocumentListener;
import javax.swing.table.DefaultTableModel;
import javax.swing.table.TableRowSorter;
import java.awt.*;
import java.awt.event.MouseAdapter;
import java.awt.event.MouseEvent;
import java.awt.event.WindowAdapter;
import java.awt.event.WindowEvent;
import java.time.LocalDate;
import java.time.format.DateTimeFormatter;
import java.time.format.DateTimeParseException;
import java.time.format.ResolverStyle;
import java.util.ArrayList;
import java.util.List;

public class ClinicSystem extends JFrame {

    private final PatientRepository repository;
    
    private JTextField txtId, txtName, txtDob, txtContact, txtSearch;
    private JComboBox<String> cbDoctor, cbSort;
    private JTable table;
    private DefaultTableModel tableModel;
    private TableRowSorter<DefaultTableModel> rowSorter;

    public ClinicSystem() {
        this.repository = new PatientRepository("clinic_directory.txt");

        setTitle("Clinic System - Academic Edition");
        setSize(1000, 520);
        setDefaultCloseOperation(JFrame.DO_NOTHING_ON_CLOSE);
        setLocationRelativeTo(null);

        addWindowListener(new WindowAdapter() {
            @Override
            public void windowClosing(WindowEvent e) {
                confirmAndExit();
            }
        });

        initUI();
        refreshTable();
        generateNextId();
    }

    private void initUI() {
        setLayout(new BorderLayout(10, 10));

        JPanel mainPanel = new JPanel(new GridLayout(1, 2, 15, 15));
        mainPanel.setBorder(BorderFactory.createEmptyBorder(15, 15, 15, 15));

        // Form Setup
        JPanel formPanel = new JPanel(new GridBagLayout());
        formPanel.setBorder(BorderFactory.createTitledBorder("New Patient Entry"));
        GridBagConstraints gbc = new GridBagConstraints();
        gbc.insets = new Insets(8, 8, 8, 8);
        gbc.fill = GridBagConstraints.HORIZONTAL;

        gbc.gridx = 0; gbc.gridy = 0;
        formPanel.add(new JLabel("Patient ID (Auto):"), gbc);
        gbc.gridx = 1;
        txtId = new JTextField(15);
        txtId.setEditable(false);
        txtId.setBackground(new Color(230, 230, 230));
        formPanel.add(txtId, gbc);

        gbc.gridx = 0; gbc.gridy = 1;
        formPanel.add(new JLabel("Name:"), gbc);
        gbc.gridx = 1;
        txtName = new JTextField(15);
        formPanel.add(txtName, gbc);

        gbc.gridx = 0; gbc.gridy = 2;
        formPanel.add(new JLabel("Date of Birth (MM/DD/YYYY):"), gbc);
        gbc.gridx = 1;
        txtDob = new JTextField(15);
        formPanel.add(txtDob, gbc);

        gbc.gridx = 0; gbc.gridy = 3;
        formPanel.add(new JLabel("Contact Number (Numbers only):"), gbc);
        gbc.gridx = 1;
        txtContact = new JTextField(15);
        formPanel.add(txtContact, gbc);

        gbc.gridx = 0; gbc.gridy = 4;
        formPanel.add(new JLabel("Assign Doctor:"), gbc);
        gbc.gridx = 1;
        cbDoctor = new JComboBox<>(new String[]{"Dr. Dagondon", "Dr. Disacula", "Dr. Perocho"});
        formPanel.add(cbDoctor, gbc);

        // Buttons
        JPanel btnPanel = new JPanel(new FlowLayout(FlowLayout.CENTER, 5, 10));
        JButton btnAdd = new JButton("Add Patient");
        JButton btnUpdate = new JButton("Update");
        JButton btnDelete = new JButton("Delete");
        JButton btnClear = new JButton("Clear");
        JButton btnExit = new JButton("Exit");

        btnPanel.add(btnAdd);
        btnPanel.add(btnUpdate);
        btnPanel.add(btnDelete);
        btnPanel.add(btnClear);
        btnPanel.add(btnExit);

        JPanel leftWrapper = new JPanel(new BorderLayout());
        leftWrapper.add(formPanel, BorderLayout.CENTER);
        leftWrapper.add(btnPanel, BorderLayout.SOUTH);

        // Table Controls
        JPanel rightWrapper = new JPanel(new BorderLayout(5, 5));
        JPanel controlPanel = new JPanel(new FlowLayout(FlowLayout.LEFT, 5, 0));
        
        controlPanel.add(new JLabel("Search:"));
        txtSearch = new JTextField(10);
        controlPanel.add(txtSearch);

        controlPanel.add(new JLabel("Sort By:"));
        cbSort = new JComboBox<>(new String[]{"ID", "Name"});
        controlPanel.add(cbSort);

        JButton btnSort = new JButton("Sort");
        controlPanel.add(btnSort);

        JPanel tablePanel = new JPanel(new BorderLayout());
        tablePanel.setBorder(BorderFactory.createTitledBorder("Patient Directory"));

        String[] columns = {"ID", "Name", "Date of Birth", "Contact", "Doctor"};
        tableModel = new DefaultTableModel(columns, 0) {
            @Override
            public boolean isCellEditable(int row, int column) {
                return false; // Lock cells from direct editing
            }
        };
        
        table = new JTable(tableModel);
        rowSorter = new TableRowSorter<>(tableModel);
        table.setRowSorter(rowSorter);

        tablePanel.add(new JScrollPane(table), BorderLayout.CENTER);

        rightWrapper.add(controlPanel, BorderLayout.NORTH);
        rightWrapper.add(tablePanel, BorderLayout.CENTER);

        mainPanel.add(leftWrapper);
        mainPanel.add(rightWrapper);
        add(mainPanel, BorderLayout.CENTER);

        // Event Handlers
        btnAdd.addActionListener(e -> addPatient());
        btnUpdate.addActionListener(e -> updatePatient());
        btnDelete.addActionListener(e -> deletePatient());
        btnClear.addActionListener(e -> clearForm());
        btnExit.addActionListener(e -> confirmAndExit());

        btnSort.addActionListener(e -> {
            int selectedIndex = cbSort.getSelectedIndex();
            List<RowSorter.SortKey> sortKeys = new ArrayList<>();
            sortKeys.add(new RowSorter.SortKey(selectedIndex, SortOrder.ASCENDING));
            rowSorter.setSortKeys(sortKeys);
        });

        txtSearch.getDocument().addDocumentListener(new DocumentListener() {
            @Override
            public void insertUpdate(DocumentEvent e) { filterTable(); }
            @Override
            public void removeUpdate(DocumentEvent e) { filterTable(); }
            @Override
            public void changedUpdate(DocumentEvent e) { filterTable(); }

            private void filterTable() {
                String text = txtSearch.getText().trim();
                if (text.isEmpty()) {
                    rowSorter.setRowFilter(null);
                } else {
                    rowSorter.setRowFilter(RowFilter.regexFilter("(?i)" + text));
                }
            }
        });

        table.addMouseListener(new MouseAdapter() {
            @Override
            public void mouseClicked(MouseEvent e) {
                int viewRow = table.getSelectedRow();
                if (viewRow >= 0) {
                    int modelRow = table.convertRowIndexToModel(viewRow);
                    txtId.setText(tableModel.getValueAt(modelRow, 0).toString());
                    txtName.setText(tableModel.getValueAt(modelRow, 1).toString());
                    txtDob.setText(tableModel.getValueAt(modelRow, 2).toString());
                    txtContact.setText(tableModel.getValueAt(modelRow, 3).toString());
                    cbDoctor.setSelectedItem(tableModel.getValueAt(modelRow, 4).toString());
                }
            }
        });
    }

    private void addPatient() {
        if (!validateInputs()) return;

        Patient p = createPatientFromInputs();
        repository.addPatient(p);
        refreshTable();
        clearForm();
        JOptionPane.showMessageDialog(this, "Patient added successfully!");
    }

    private void updatePatient() {
        int viewRow = table.getSelectedRow();
        if (viewRow < 0) {
            JOptionPane.showMessageDialog(this, "Please select a row from the table first.", "Warning", JOptionPane.WARNING_MESSAGE);
            return;
        }

        if (!validateInputs()) return;

        int modelRow = table.convertRowIndexToModel(viewRow);
        Patient p = createPatientFromInputs();
        repository.updatePatient(modelRow, p);
        refreshTable();
        clearForm();
        JOptionPane.showMessageDialog(this, "Patient info updated successfully!");
    }

    private void deletePatient() {
        int viewRow = table.getSelectedRow();
        if (viewRow < 0) {
            JOptionPane.showMessageDialog(this, "Please select a row to delete.", "Warning", JOptionPane.WARNING_MESSAGE);
            return;
        }

        int modelRow = table.convertRowIndexToModel(viewRow);
        repository.deletePatient(modelRow);
        refreshTable();
        clearForm();
        JOptionPane.showMessageDialog(this, "Patient deleted successfully!");
    }

    private Patient createPatientFromInputs() {
        // Sanitize input to prevent delimiter leakage
        String cleanName = txtName.getText().trim().replace("|", "");
        String cleanContact = txtContact.getText().trim().replace("|", "");
        
        return new Patient(
            txtId.getText().trim(),
            cleanName,
            txtDob.getText().trim(),
            cleanContact,
            cbDoctor.getSelectedItem().toString()
        );
    }

    private boolean validateInputs() {
        String name = txtName.getText().trim();
        if (name.isEmpty()) {
            JOptionPane.showMessageDialog(this, "Please fill out the Name field.", "Validation Error", JOptionPane.ERROR_MESSAGE);
            return false;
        }

        String dob = txtDob.getText().trim();
        try {
            DateTimeFormatter formatter = DateTimeFormatter.ofPattern("MM/dd/uuuu")
                    .withResolverStyle(ResolverStyle.STRICT);
            LocalDate parsedDate = LocalDate.parse(dob, formatter);
            
            if (parsedDate.isAfter(LocalDate.now())) {
                JOptionPane.showMessageDialog(this, "Date of birth cannot be in the future!", "Validation Error", JOptionPane.ERROR_MESSAGE);
                return false;
            }
        } catch (DateTimeParseException e) {
            JOptionPane.showMessageDialog(this, "Invalid calendar date!\nPlease ensure format is MM/DD/YYYY and represents a valid past day.", "Validation Error", JOptionPane.ERROR_MESSAGE);
            return false;
        }

        String contact = txtContact.getText().trim();
        if (!contact.matches("\\d+")) {
            JOptionPane.showMessageDialog(this, "Contact number must contain digits only!", "Validation Error", JOptionPane.ERROR_MESSAGE);
            return false;
        }

        return true;
    }

    private void refreshTable() {
        tableModel.setRowCount(0);
        for (Patient p : repository.getAllPatients()) {
            tableModel.addRow(p.toRowData());
        }
    }

    private void generateNextId() {
        txtId.setText(String.valueOf(repository.generateNextId()));
    }

    private void clearForm() {
        generateNextId();
        txtName.setText("");
        txtDob.setText("");
        txtContact.setText("");
        cbDoctor.setSelectedIndex(0);
        table.clearSelection();
    }

    private void confirmAndExit() {
        int choice = JOptionPane.showConfirmDialog(
            this,
            "Are you sure you want to exit the Clinic System?",
            "Confirm Exit",
            JOptionPane.YES_NO_OPTION,
            JOptionPane.QUESTION_MESSAGE
        );
        if (choice == JOptionPane.YES_OPTION) {
            System.exit(0);
        }
    }

    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> new ClinicSystem().setVisible(true));
    }
}
